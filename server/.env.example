# Copy this file to .env (or set these as real environment variables in your deploy
# platform) and fill in real values. Nothing in this file is a working default — every
# value below is a placeholder.

# --- Required in every deployment (production, staging, or a shared dev server) -------

# Postgres connection string. If unset, the server auto-provisions a local embedded
# Postgres instance instead (server/src/db/devPostgres.ts) — convenient for solo local
# dev, but that fallback does NOT apply once DATABASE_URL is set, and production must
# always set it.
#
# SSL is on by default for any host other than localhost/127.0.0.1/the docker-compose
# `postgres` service (see db/pool.ts's shouldUseSsl) — right for a managed Postgres like
# Supabase. Self-hosting your own Postgres at a real host/IP with no SSL configured (a
# plain `apt install postgresql` doesn't set one up)? Append `?sslmode=disable`:
#   postgres://user:password@203.0.113.10:5432/database?sslmode=disable
DATABASE_URL=postgres://user:password@host:port/database

# Signs and verifies session cookies (server/src/auth/session.ts). Required with no
# fallback — the app refuses to start without it, on purpose (fail-closed: a missing
# secret must be a loud startup failure, never a silent weak-default session). Generate
# one with: openssl rand -base64 48
# Local dev is the one exception: running `npm run dev` (server/src/index.ts) supplies a
# fixed placeholder automatically via localDevSecret.ts if this isn't set, so solo local
# dev works without any setup step — but that file is never used by the production entry
# point (api/index.ts), so real deploys still need this set for real.
JWT_SECRET=

# --- Optional -------------------------------------------------------------------------

# HTTP port for the local/Render entry (server/src/index.ts) — irrelevant on Vercel,
# which manages the port itself. Defaults to 4000.
PORT=4000

# Set to "false" to skip auto-seeding ~3,000 synthetic demo assets on boot (local/Render
# entry only — the Vercel serverless entry never seeds by default, see api/index.ts).
SEED_ON_BOOT=true

# How many synthetic assets to generate when seeding. Defaults to 3000.
SEED_COUNT=3000

# Google Sign-In (routes/auth.ts, auth/googleSso.ts) — lets users sign in with their
# company Google account instead of a NephroAssets password. Both required together;
# unset (either one) means the feature is off: the login page's Google button doesn't
# render, and /api/auth/google returns a clean 401. Does NOT auto-create accounts — an
# admin must already have created the user (Admin → Users) with a matching email.
#
# GOOGLE_CLIENT_ID: the OAuth 2.0 Client ID of a GCP "Web application" OAuth client
# (APIs & Services → Credentials). Not a secret — it's sent to the browser so the login
# page can initialize Google's Sign In button with it.
GOOGLE_CLIENT_ID=
# GOOGLE_WORKSPACE_DOMAIN: only Google accounts on this Workspace domain (e.g.
# nephroplus.com) may sign in — any other Google account, even one that happens to match
# a user's email, is rejected.
GOOGLE_WORKSPACE_DOMAIN=

# AI Register Search (routes/aiSearch.ts) — the "Ask AI" search on the Register screen
# that turns a plain-English question into register filters. Unset means the feature is
# off: the endpoint returns a clean 503 and the client hides the AI button, everything
# else in the app is unaffected. Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Which OpenAI model AI Register Search calls. Defaults to gpt-4o-mini — cheap and
# reliable enough for this task (mapping a short question onto a fixed, small set of
# filter fields), not a task that benefits from a larger/pricier model.
AI_SEARCH_MODEL=gpt-4o-mini

# Per-user daily cap on AI Register Search calls (routes/aiSearch.ts, ai_search_log
# table) — a cost guard, not a precise budget. Defaults to 40.
AI_SEARCH_DAILY_LIMIT=40

# Background Register export (routes/assetsExportJobs.ts) — a large/filtered export runs
# as a resumable multipart upload to an S3-compatible bucket instead of one synchronous
# streamed response, so it can't hit Vercel's 60s function ceiling. Works with either real
# AWS S3 (leave EXPORT_S3_ENDPOINT unset) or Cloudflare R2 (set EXPORT_S3_ENDPOINT to your
# account's R2 S3 API endpoint). Unset means the feature is off: POST /api/assets/export/
# jobs returns a clean 503 and the client falls back to the existing synchronous export —
# everything else in the app is unaffected.
EXPORT_S3_BUCKET=
EXPORT_S3_ACCESS_KEY_ID=
EXPORT_S3_SECRET_ACCESS_KEY=
# Real AWS S3: your bucket's region (e.g. ap-south-1). R2: leave as "auto".
EXPORT_S3_REGION=auto
# R2 only — e.g. https://<account-id>.r2.cloudflarestorage.com. Leave unset for real AWS S3.
EXPORT_S3_ENDPOINT=

# --- One-off scripts, not read by the running app itself -------------------------------

# server/src/scripts/seedAdmin.ts — creates/updates the first admin user. Usage:
#   ADMIN_USERNAME=... ADMIN_EMAIL=... ADMIN_PASSWORD=... npx tsx src/scripts/seedAdmin.ts
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# server/src/scripts/migrateToSupabase.ts — one-time data migration between two Postgres
# databases. Usage:
#   SOURCE_DATABASE_URL=... DEST_DATABASE_URL=... npx tsx src/scripts/migrateToSupabase.ts
SOURCE_DATABASE_URL=
DEST_DATABASE_URL=
