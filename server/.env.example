# Copy this file to .env (or set these as real environment variables in your deploy
# platform) and fill in real values. Nothing in this file is a working default — every
# value below is a placeholder.

# --- Required in every deployment (production, staging, or a shared dev server) -------

# Postgres connection string. If unset, the server auto-provisions a local embedded
# Postgres instance instead (server/src/db/devPostgres.ts) — convenient for solo local
# dev, but that fallback does NOT apply once DATABASE_URL is set, and production must
# always set it (Supabase, in this app's current deploy).
DATABASE_URL=postgres://user:password@host:port/database

# Signs and verifies session cookies (server/src/auth/session.ts). Required with no
# fallback — the app refuses to start without it, on purpose (fail-closed: a missing
# secret must be a loud startup failure, never a silent weak-default session). Generate
# one with: openssl rand -base64 48
# Local dev is the one exception: running `npm run dev` (server/src/index.ts) supplies a
# fixed placeholder automatically via localDevSecret.ts if this isn't set, so solo local
# dev works without any setup step — but that file is never used by the production entry
# point (api/index.ts), so real deploys still need this set for real.
JWT_SECRET=

# --- Optional -------------------------------------------------------------------------

# HTTP port for the local/Render entry (server/src/index.ts) — irrelevant on Vercel,
# which manages the port itself. Defaults to 4000.
PORT=4000

# Set to "false" to skip auto-seeding ~3,000 synthetic demo assets on boot (local/Render
# entry only — the Vercel serverless entry never seeds by default, see api/index.ts).
SEED_ON_BOOT=true

# How many synthetic assets to generate when seeding. Defaults to 3000.
SEED_COUNT=3000

# --- One-off scripts, not read by the running app itself -------------------------------

# server/src/scripts/seedAdmin.ts — creates/updates the first admin user. Usage:
#   ADMIN_USERNAME=... ADMIN_EMAIL=... ADMIN_PASSWORD=... npx tsx src/scripts/seedAdmin.ts
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# server/src/scripts/migrateToSupabase.ts — one-time data migration between two Postgres
# databases. Usage:
#   SOURCE_DATABASE_URL=... DEST_DATABASE_URL=... npx tsx src/scripts/migrateToSupabase.ts
SOURCE_DATABASE_URL=
DEST_DATABASE_URL=
