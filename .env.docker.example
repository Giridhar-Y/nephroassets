# Copy this file to `.env` (same directory as docker-compose.yml) and fill in real
# values. `docker run --env-file .env ...` and `docker compose up` both read it from
# here. Nothing below is a working default — every value is a placeholder.
#
# Never commit the real `.env` file — it's already excluded via .gitignore/.dockerignore.

# --- Required --------------------------------------------------------------------------

# Postgres connection string. Point this at your own managed/self-hosted Postgres —
# NOT the optional `postgres` service in docker-compose.yml, which exists only for local
# container testing (see that file's own comment). Format:
#   postgres://user:password@host:port/database
DATABASE_URL=postgres://user:password@host:5432/nephroassets

# Signs and verifies login session cookies. The app refuses to start without this set —
# that's deliberate (a missing secret must be a loud startup failure, never a silent
# weak default). Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Runtime ---------------------------------------------------------------------------

# Must match whatever port you map in `docker run -p` / docker-compose.yml's own port
# mapping — the container listens on this port internally regardless of what host port
# you expose it as.
PORT=3000

# Baked into the image's runner stage already (see Dockerfile) — listed here only so
# it's visible if you're running the compiled server directly outside the image.
NODE_ENV=production

# --- Optional: background export to S3-compatible storage ------------------------------
# Large/filtered Register or Activity Log exports run as a resumable multipart upload
# instead of a single request, so they can't hit a slow-request timeout no matter how
# big they get. Leave all four blank to turn this off entirely — the app falls back to a
# smaller synchronous export, nothing else is affected.

EXPORT_S3_BUCKET=
EXPORT_S3_ACCESS_KEY_ID=
EXPORT_S3_SECRET_ACCESS_KEY=
# Real AWS S3: your bucket's region (e.g. ap-south-1). Cloudflare R2: leave as "auto".
EXPORT_S3_REGION=auto
# Cloudflare R2 only — e.g. https://<account-id>.r2.cloudflarestorage.com.
# Leave unset for real AWS S3.
EXPORT_S3_ENDPOINT=

# --- Optional: "Ask AI" Register search -------------------------------------------------
# Leave blank to turn this one feature off — the button hides client-side, everything
# else works normally.

OPENAI_API_KEY=
